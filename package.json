{
  "name": "@memestudio/deepseek-harness",
  "version": "2.0.0",
  "description": "Connect a running MemeStudio desktop instance to DeepSeek Harness over a same-user Windows Named Pipe",
  "private": true,
  "icon": "./icon.svg",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
