{
  "api_version": 2,
  "id": "memestudio.batch-convert",
  "name": "多源批量转换",
  "version": "2.0.0",
  "description": "独立的多文件与目录批量表情转换队列插件，支持文件头极速扫描、防覆盖规划与单条容错续跑。",
  "library": "batch-convert.dll",
  "commands": [
    {
      "id": "open-panel",
      "title": "批量队列…",
      "toolbar": true
    },
    {
      "id": "inspect-sources",
      "title": "扫描校验素材队列",
      "toolbar": false
    },
    {
      "id": "run-batch",
      "title": "执行批量转换队列",
      "toolbar": false
    }
  ]
}
